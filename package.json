{
  "name": "hashglyph",
  "version": "0.0.1",
  "description": "Deterministically generate SVG glyphs that distantly resemble CJK graphemes, from a 64-bit hash string.",
  "license": "The Unlicense",
  "main": "./index.js",
  "bin": {
    "hashglyph": "./index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test && node -e \"console.log(require('node:crypto').randomBytes(8).toString('hex'))\" | node index.js > output.svg"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  }
}
